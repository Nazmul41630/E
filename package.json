{
  "name": "cakehaus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "wrangler pages dev public --port 8788 --persist-to .wrangler/state",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:local": "wrangler d1 execute cakehaus-db --local --persist-to .wrangler/state --file=db/schema.sql",
    "db:seed": "wrangler d1 execute cakehaus-db --local --persist-to .wrangler/state --file=db/seed.sql",
    "db:admin": "node scripts/seed-admin.mjs --local",
    "db:remote": "wrangler d1 execute cakehaus-db --remote --file=db/schema.sql",
    "db:seed:remote": "wrangler d1 execute cakehaus-db --remote --file=db/seed.sql"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
